{
  "name": "day1-organizer-publishing",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc -b && vite build",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.integration.json --pretty false && tsc -p tsconfig.e2e.json --pretty false && tsc -p tsconfig.scripts.json --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:moderation": "tests/integration/run-moderation-proof.sh",
    "test:build25": "VITE_SUPABASE_URL=https://task16-disabled.supabase.co VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_task16_disabled VITE_MAPBOX_ACCESS_TOKEN=task16-disabled VITE_STRIPE_PUBLISHABLE_KEY=pk_test_task16_disabled vitest run src/features/auth/SessionProvider.test.tsx src/features/moderation/EventPolicyPage.test.tsx src/features/moderation/EventRequirementsStep.test.tsx src/features/moderation/ModerationCasePage.test.tsx src/features/moderation/ModerationQueuePage.test.tsx src/features/moderation/OrganizerAgreementStep.test.tsx src/features/moderation/OrganizerTermsPage.test.tsx src/features/moderation/ReportEventDialog.test.tsx src/features/moderation/RequireStaff.test.tsx src/features/moderation/moderation.api.test.ts src/features/moderation/moderation.queries.test.tsx src/features/moderation/moderation.schemas.test.ts src/features/events/EventEditorPage.test.tsx src/features/events/EventPreviewPage.test.tsx src/features/events/EventReviewStep.test.tsx src/features/events/LocationSearchField.test.tsx src/features/events/OrganizerEventsPage.test.tsx src/features/events/PublishedEventPage.test.tsx src/features/events/event.schemas.test.ts src/features/tickets/OrganizerTicketTiersPage.test.tsx src/features/tickets/PublicTicketEventPage.test.tsx src/features/tickets/publicTicketing.api.test.ts src/features/tickets/publicTicketing.queries.test.tsx src/features/tickets/ticket.queries.test.tsx src/features/tickets/ticket.schemas.test.ts src/app/router/router.test.tsx src/components/layout/OrganizerLayout.test.tsx",
    "test:integration:ticketing-db": "tests/integration/run-ticketing-database.sh",
    "test:core-ticket-lite": "pnpm test:ticket-shells && pnpm test:functions && pnpm test:integration:core-ticket-lite",
    "test:integration:core-ticket-lite": "vitest run --config vitest.integration.config.ts tests/integration/coreTicketTruthLiteRunnerContract.test.ts tests/integration/coreTicketTruthLiteCleanup.test.ts tests/integration/coreTicketTruthLiteAdmissionTransport.test.ts && deno test --allow-env tests/integration/edge/task17-transaction-driver/contracts.test.ts",
    "test:e2e:core-ticket-lite": "bash tests/e2e/run-core-ticket-truth-lite-proof.sh",
    "test:e2e:ticketing": "tests/e2e/run-ticketing-browser-proof.sh",
    "test:e2e:moderation": "tests/e2e/run-moderation-browser-proof.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "supabase": "supabase",
    "test:functions": "deno task test",
    "email:test:ticket-ready": "tsx --tsconfig tsconfig.scripts.json scripts/send-ticket-ready-test.tsx",
    "test:ticket-shells": "vitest run src/features/ticket-experience scripts/send-ticket-ready-test.test.ts",
    "test:ticket-shells:production": "vitest run src/app/router/router.test.tsx && pnpm build && tsx --tsconfig tsconfig.scripts.json scripts/verify-ticket-shell-production.ts",
    "test:functions:moderation": "deno test --allow-env supabase/functions/report-event/index.test.ts supabase/functions/moderate-event-queue/index.test.ts",
    "typecheck:functions": "deno task check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@mapbox/search-js-react": "^1.6.0",
    "@stripe/connect-js": "3.4.6",
    "@stripe/react-connect-js": "3.4.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.102.2",
    "@zxing/browser": "0.2.1",
    "qrcode.react": "4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "deno": "2.9.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "resend": "6.26.0",
    "stripe": "22.5.0",
    "supabase": "^2.115.0",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
