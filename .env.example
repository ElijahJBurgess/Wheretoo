VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAPBOX_ACCESS_TOKEN=
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional real monitored support address for ticket recovery; hidden when absent/invalid.
VITE_TICKET_SUPPORT_EMAIL=

# Optional approved Organizer Settings destinations. Missing/invalid values show unavailable states.
# Organizer support falls back to VITE_TICKET_SUPPORT_EMAIL; closure falls back to organizer support.
VITE_ORGANIZER_SUPPORT_EMAIL=
VITE_ACCOUNT_CLOSURE_EMAIL=
# Use only approved HTTPS policy pages; development placeholders are not legal destinations.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Waitlist remains inactive until a separate activation task.
WAITLIST_PUBLIC_ENABLED=false
WAITLIST_OBSERVER_ENABLED=false
WAITLIST_DELIVERY_ENABLED=false
WAITLIST_OBSERVER_SECRET=
WAITLIST_DELIVERY_SECRET=
WAITLIST_RATE_SECRET=
WAITLIST_TRUSTED_IP_HEADER=

# Server-only CSV address verification; leave unset until separately authorized activation.
# Permanent geocoding storage entitlement must be verified before enabling imports.
MAPBOX_GEOCODING_ACCESS_TOKEN=
