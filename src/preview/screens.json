{
  "sign-in": "<div class=\"onboarding\"><div class=\"onboarding__frame\"><header class=\"onboarding__header\"><a class=\"onboarding__brand\" data-discover=\"true\">wheretoo</a></header><main class=\"onboarding__main\"><section aria-labelledby=\"signin-title\" class=\"onboarding-form\"><p class=\"onboarding__eyebrow\">Welcome back</p><h1 id=\"signin-title\">Sign in</h1><p class=\"onboarding__intro\">Your next great event starts here.</p><form class=\"auth-form\" novalidate=\"\"><div class=\"ui-field\"><label class=\"ui-field__label\" for=\"email\">Email</label><input autocomplete=\"email\" inputmode=\"email\" id=\"email\" type=\"email\" name=\"email\" value=\"\"></div><div class=\"ui-field\"><label class=\"ui-field__label\" for=\"password\">Password</label><input autocomplete=\"current-password\" id=\"password\" type=\"password\" name=\"password\" value=\"\"></div><button class=\"ui-button ui-button--primary\" type=\"submit\">Sign in</button></form><p class=\"onboarding__alternate\">New to wheretoo? <a data-discover=\"true\">Create organizer account</a></p></section></main></div><p class=\"onboarding__signature\">Good events. Better operations.</p></div>",
  "sign-up": "<div class=\"onboarding\"><div class=\"onboarding__frame onboarding__frame--hero\"><header class=\"onboarding__header\"><a class=\"onboarding__brand\" data-discover=\"true\">wheretoo</a><a class=\"onboarding__header-link\" data-discover=\"true\">Log in</a></header><main class=\"onboarding__main\"><section aria-labelledby=\"signup-title\" class=\"onboarding-form onboarding-form--signup\"><h1 id=\"signup-title\">Create your<br> organizer account</h1><p class=\"onboarding__intro\">Bring people together.<br>We’ll handle the rest.</p><form class=\"auth-form\" novalidate=\"\"><div class=\"ui-field\"><label class=\"ui-field__label\" for=\"fullName\">Full name</label><input autocomplete=\"name\" placeholder=\"Your full name\" id=\"fullName\" name=\"fullName\" value=\"\"></div><div class=\"ui-field\"><label class=\"ui-field__label\" for=\"email\">Email</label><input autocomplete=\"email\" inputmode=\"email\" placeholder=\"you@yourcompany.com\" id=\"email\" type=\"email\" name=\"email\" value=\"\"></div><div class=\"ui-field\"><label class=\"ui-field__label\" for=\"password\">Password</label><input autocomplete=\"new-password\" placeholder=\"Create a password\" id=\"password\" type=\"password\" name=\"password\" value=\"\"></div><button class=\"ui-button ui-button--primary\" type=\"submit\">Create account</button></form><p class=\"onboarding__legal\">By creating an account, you agree to our <a data-discover=\"true\">Organizer Terms</a> and Privacy Policy.</p><p class=\"onboarding__alternate\">Already have an account? <a data-discover=\"true\">Log in</a></p></section></main></div><p class=\"onboarding__signature\">Good events. Better operations.</p></div>",
