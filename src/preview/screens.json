  "organizer-setup": "<div class=\"onboarding\"><div class=\"onboarding__frame\"><header class=\"onboarding__header\"><p class=\"onboarding__page-title\">Organizer Profile</p></header><main class=\"onboarding__main\"><div class=\"profile-editor\"><section class=\"onboarding-form onboarding-form--profile\" aria-labelledby=\"organizer-profile-title\"><ol aria-label=\"Organizer onboarding progress\" class=\"onboarding-progress\"><li class=\"is-complete\"><span aria-hidden=\"true\" class=\"onboarding-progress__number\"><svg aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewBox=\"0 0 24 24\"><path d=\"m5 12 4 4L19 6\"></path></svg></span><span>Account<span class=\"onboarding__sr-only\"> complete</span></span></li><li aria-current=\"step\" class=\"\"><span aria-hidden=\"true\" class=\"onboarding-progress__number\">2</span><span>Profile</span></li><li class=\"\"><span aria-hidden=\"true\" class=\"onboarding-progress__number\">3</span><span>Payouts</span></li></ol><h1 id=\"organizer-profile-title\" class=\"onboarding__sr-only\">Organizer Profile</h1><form class=\"auth-form settings-form\" novalidate=\"\"><div tabindex=\"-1\"></div><fieldset class=\"profile-editor__group\"><legend>Basic information</legend><div class=\"ui-field\"><label class=\"ui-field__label\" for=\"displayName\">Organizer / business name</label><input autocomplete=\"organization\" id=\"displayName\" name=\"displayName\" value=\"Good Company\"></div><div class=\"ui-field\"><label class=\"ui-field__label\" for=\"organizerType\">Organizer type</label><select name=\"organizerType\" id=\"organizerType\"><option value=\"\">Choose a type (optional)</option><option>Venue</option><option>Promoter</option><option>Restaurant</option><option selected=\"\">Community group</option><option>Run club</option><option>Museum</option><option>Business</option><option>Event creator</option></select></div><div class=\"ui-field\"><label class=\"