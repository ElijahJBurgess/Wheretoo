  "published-event": "<div class=\"organizer-layout\"><header class=\"organizer-layout__header\"><a class=\"product-mark\">whereto</a><nav aria-label=\"Organizer\"><div class=\"organizer-layout__nav\"><a>Events</a><a>Payments</a><button class=\"organizer-layout__sign-out\" type=\"button\">Sign out</button></div></nav></header><main class=\"organizer-layout__main\"><section aria-labelledby=\"published-event-title\" class=\"published-event\"><header class=\"published-event__status\"><div><p class=\"organizer-eyebrow\">Event status</p><h1 id=\"published-event-title\">Published</h1><p>Published September 1, 2026 at 5:00 AM</p></div></header><div aria-live=\"polite\" class=\"published-event__notice published-event__notice--public\"><p>This event is publicly available.</p></div><article class=\"event-summary\"><div aria-label=\"Whereto event artwork placeholder\" class=\"event-summary__artwork\" role=\"img\"><span>Whereto presents</span><strong>Sunset Rooftop Sessions</strong><small>Event artwork coming soon</small></div><div class=\"event-summary__content\"><header class=\"event-summary__header\"><p class=\"organizer-eyebrow\">Persisted event preview</p><h2>Sunset Rooftop Sessions</h2><p>Hosted by Good Company</p></header><dl class=\"event-summary__facts\"><div><dt>Date</dt><dd>Saturday, September 19, 2026</dd></div><div><dt>Time</dt><dd>7:00 PM–10:00 PM</dd></div><div><dt>Timezone</dt><dd>Pacific time (America/Los_Angeles)</dd></div><div><dt>Category</dt><dd>Music</dd></div><div><dt>Admission</dt><dd>Paid</dd></div><div><dt>Venue</dt><dd>Lakeview Rooftop</dd></div><div class=\"event-summary__wide\"><dt>Address</dt><dd>123 Lakeview Avenue, Oakland, CA 94612</dd></div></dl><section aria-labelledby=\"event-summary-description\" class=\"event-summary__description\"><h3 id=\"event-summary-description\">About this event</h3><p>Afro house, open-air views, skyline nights.</p></section></div></article><footer class=\"published-event__actions\"><a class=\"ui-button ui-button--sec